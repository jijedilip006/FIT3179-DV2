{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Binned density map showing concentration of Victorian beaches.",
  "width": 700,
  "height": 500,
  "projection": {
    "type": "mercator",
    "center": [145, -37.5],
    "scale": 4200
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e0e0e0",
        "stroke": "white",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "../data/vic_beaches_1.csv",
        "format": {
          "type": "csv",
          "parse": {
            "longitude": "number",
            "latitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.longitude) && isValid(datum.latitude) && isFinite(datum.longitude) && isFinite(datum.latitude)"
        },
        {
          "bin": {"step": 0.2},
          "field": "longitude",
          "as": "binned_lon"
        },
        {
          "bin": {"step": 0.2},
          "field": "latitude",
          "as": "binned_lat"
        },
        {
          "aggregate": [{"op": "count", "as": "beach_count"}],
          "groupby": ["binned_lon", "binned_lat"]
        }
      ],
      "mark": {
        "type": "square",
        "opacity": 0.8,
        "stroke": "#08519c",
        "strokeWidth": 0.5
      },
      "encoding": {
        "longitude": {
          "field": "binned_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "binned_lat",
          "type": "quantitative"
        },
        "size": {
          "field": "beach_count",
          "type": "quantitative",
          "scale": {"range": [60, 400]},
          "legend": {"title": "Beach Count"}
        },
        "color": {
          "field": "beach_count",
          "type": "quantitative",
          "scale": {"scheme": "blues"},
          "legend": {"title": "Beach Density"}
        },
        "tooltip": [
          {"field": "beach_count", "type": "quantitative", "title": "Beaches in Area"},
          {"field": "binned_lon", "type": "quantitative", "title": "Approx Longitude"},
          {"field": "binned_lat", "type": "quantitative", "title": "Approx Latitude"}
        ]
      }
    }
  ]
}