      {"region": "Brisbane", "trips": 8149000, "nights": 25602000},
      {"region": "North Coast NSW", "trips": 6239000, "nights": 20590000},
      {"region": "Perth", "trips": 4449000, "nights": 15116000},
      {"region": "Gold Coast", "trips": 4286000, "nights": 14893000},
      {"region": "South Coast NSW", "trips": 4493000, "nights": 14810000},
      {"region": "Sunshine Coast", "trips": 4027000, "nights": 13519000},
