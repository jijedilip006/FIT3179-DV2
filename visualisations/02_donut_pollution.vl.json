{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Donut chart showing the proportion of NSW beaches by their pollution forecast.",
  "data": {
    "url": "../data/data.csv"
  },
  "transform": [
    {
      "aggregate": [{"op": "count", "as": "count"}],
      "groupby": ["pollution_forecast"]
    }
  ],
  "width": 380,
  "height": 380,
  "encoding": {
    "theta": {
      "field": "count",
      "type": "quantitative",
      "stack": true
    },
    "color": {
      "field": "pollution_forecast",
      "type": "nominal",
      "scale": {
        "domain": ["Unlikely", "Possible", "Likely", "Forecast not available"],
        "range": ["#2ca02c", "#ff7f0e", "#d62728", "#7f7f7f"]
      },
      "legend": {"title": "Pollution Forecast"}
    },
    "tooltip": [
      {"field": "pollution_forecast", "type": "nominal", "title": "Forecast"},
      {"field": "count", "type": "quantitative", "title": "Number of Beaches"}
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 90,
        "outerRadius": 160,
        "stroke": "#fff",
        "strokeWidth": 1.5
      }
    },
    {
      "mark": {
        "type": "text",
        "radius": 125,
        "fontSize": 13,
        "fontWeight": "bold",
        "fill": "white"
      },
      "encoding": {
        "text": {"field": "count", "type": "quantitative"}
      }
    }
  ]
}