{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Interactive map of coastal hazards with slider filter.",
  "width": 800,
  "height": 450,
  "projection": {
    "type": "mercator",
    "center": [145, -37.5],
    "scale": 4500
  },
  "params": [
    {
      "name": "Minimum_Hazard",
      "value": 1,
      "bind": {
        "input": "range",
        "min": 1,
        "max": 10,
        "step": 1,
        "name": "Filter Minimum Hazard Rating: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e2e8f0",
        "stroke": "#ffffff",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "../data/BEACH_FACILITIES_SAFETY.csv",
        "format": {
          "type": "csv",
          "parse": {
            "longitude": "number",
            "latitude": "number",
            "HAZARD_RAT": "number"
          }
        }
      },
      "transform": [
        {"filter": "datum.HAZARD_RAT >= Minimum_Hazard"}
      ],
      "mark": {
        "type": "circle",
        "size": 40,
        "opacity": 0.9,
        "stroke": "black",
        "strokeWidth": 0.2
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "color": {
          "field": "HAZARD_RAT",
          "type": "quantitative",
          "scale": {"scheme": "redyellowblue", "reverse": true},
          "title": "Hazard Rating (1-10)"
        },
        "tooltip": [
          {"field": "BEACH", "type": "nominal", "title": "Beach Name"},
          {"field": "HAZARD_RAT", "type": "quantitative", "title": "Hazard Rating"},
          {"field": "SHARKS", "type": "nominal", "title": "Sharks"},
          {"field": "BLUEBOTTLE", "type": "nominal", "title": "Bluebottles"}
        ]
      }
    }
  ]
}