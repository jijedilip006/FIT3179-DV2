{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Lollipop chart ranking the 20 NSW beaches with the lowest water quality ratings.",
  "data": {
    "url": "../data/data.csv"
  },
  "transform": [
    {"filter": "datum.latest_result_rating != null"},
    {
      "window": [{"op": "row_number", "as": "row_number"}],
      "sort": [
        {"field": "latest_result_rating", "order": "ascending"},
        {"field": "site_name", "order": "ascending"}
      ]
    },
    {"filter": "datum.row_number <= 20"}
  ],
  "width": 600,
  "height": 350,
  "encoding": {
    "x": {
      "field": "site_name",
      "type": "nominal",
      "sort": {"field": "latest_result_rating", "order": "ascending"},
      "axis": {"labelAngle": -45, "title": "NSW Swim Site (Lowest Ratings)"}
    },
    "y": {
      "field": "latest_result_rating",
      "type": "quantitative",
      "axis": {"title": "Water Quality Rating (1 = Bad, 4 = Good)"}
    }
  },
  "layer": [
    {
      "mark": {"type": "rule", "strokeWidth": 2},
      "encoding": {
        "y": {"datum": 0},
        "y2": {"field": "latest_result_rating"}
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 250},
      "encoding": {
        "color": {
          "field": "latest_result",
          "type": "nominal",
          "scale": {
            "domain": ["Good", "Fair", "Poor", "Bad"], 
            "range": ["#2ca02c", "#ff7f0e", "#d62728", "#8c564b"]
          },
          "legend": {"title": "Observation Result"}
        }
      }
    }
  ]
}