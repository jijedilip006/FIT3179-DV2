{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Interactive map of Victorian beach amenities.",
  "width": 800,
  "height": 450,
  "projection": {
    "type": "mercator",
    "center": [145, -37.5],
    "scale": 4500
  },
  "data": {
    "url": "data/BEACH_FACILITIES_SAFETY.csv",
    "format": {
      "type": "csv",
      "parse": {
        "longitude": "number",
        "latitude": "number"
      }
    }
  },
  "mark": {
    "type": "circle",
    "size": 60,
    "opacity": 0.9,
    "stroke": "white",
    "strokeWidth": 0.5
  },
  "encoding": {
    "longitude": {"field": "longitude", "type": "quantitative"},
    "latitude": {"field": "latitude", "type": "quantitative"},
    "color": {
      "field": "BBQ",
      "type": "nominal",
      "scale": {
        "domain": ["FALSE", "TRUE"],
        "range": ["#cbd5e1", "#10b981"]
      },
      "legend": {"title": "BBQ Available"}
    },
    "tooltip": [
      {"field": "BEACH", "type": "nominal", "title": "Beach Name"},
      {"field": "BBQ", "type": "nominal", "title": "BBQ"},
      {"field": "PICNIC", "type": "nominal", "title": "Picnic Area"},
      {"field": "PLAYGROUND", "type": "nominal", "title": "Playground"},
      {"field": "KIOSK", "type": "nominal", "title": "Kiosk"}
    ]
  }
}