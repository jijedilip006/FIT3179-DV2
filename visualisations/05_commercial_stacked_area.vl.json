{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Commercial Infrastructure Retreat",
    "subtitle": [
      "Proportion of beaches with kiosks across hazard severity.",
      "Source: Victorian Beach Facilities & Safety"
    ],
    "anchor": "start",
    "subtitleFontStyle": "italic",
    "subtitleColor": "#64748b",
    "fontSize": 16,
    "subtitleFontSize": 11,
    "offset": 15
  },
  "width": 350,
  "height": 250,
  "data": {
    "url": "data/BEACH_FACILITIES_SAFETY.csv"
  },
  "transform": [
    {"filter": "datum.KIOSK == 'TRUE' || datum.KIOSK == 'FALSE'"}
  ],
  "mark": {
    "type": "area",
    "interpolate": "monotone",
    "line": true
  },
  "encoding": {
    "x": {
      "field": "HAZARD_RAT",
      "type": "quantitative",
      "title": "Hazard Rating (1 = Low, 10 = High)",
      "axis": {"tickCount": 10}
    },
    "y": {
      "aggregate": "count",
      "type": "quantitative",
      "stack": "normalize",
      "axis": {"format": "%", "title": "Percentage of Beaches"}
    },
    "color": {
      "field": "KIOSK",
      "type": "nominal",
      "title": "Kiosk Available",
      "scale": {
        "domain": ["TRUE", "FALSE"],
        "range": ["#0284c7", "#e2e8f0"]
      }
    },
    "tooltip": [
      {"field": "HAZARD_RAT", "type": "quantitative", "title": "Hazard Rating"},
      {"field": "KIOSK", "type": "nominal", "title": "Has Kiosk?"},
      {"aggregate": "count", "type": "quantitative", "title": "Number of Beaches"}
    ]
  }
}