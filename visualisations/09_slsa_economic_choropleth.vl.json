{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Economic Contribution of Volunteer Lifesavers",
    "subtitle": [
      "Billions of dollars generated by coastal safety networks (2024).",
      "Source: SLSA National Coastal Safety Report"
    ],
    "anchor": "start",
    "subtitleFontStyle": "italic",
    "subtitleColor": "#64748b",
    "fontSize": 16,
    "subtitleFontSize": 11,
    "offset": 15
  },
  "width": 450,
  "height": 350,
  "projection": {"type": "mercator"},
  "layer": [
    {
      "data": {
        "url": "data/slsa_data.csv"
      },
      "transform": [
        {"filter": "datum.year == 2024"},
        {
          "calculate": "datum.state === 'NSW' ? 'New South Wales' : datum.state === 'VIC' ? 'Victoria' : datum.state === 'QLD' ? 'Queensland' : datum.state === 'WA' ? 'Western Australia' : datum.state === 'SA' ? 'South Australia' : datum.state === 'TAS' ? 'Tasmania' : datum.state === 'NT' ? 'Northern Territory' : datum.state",
          "as": "Full_State"
        },
        {
          "lookup": "Full_State",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
              "format": {"type": "json", "property": "features"}
            },
            "key": "properties.STATE_NAME",
            "fields": ["type", "geometry"]
          }
        }
      ],
      "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 1},
      "encoding": {
        "color": {
          "field": "economic_value_billions",
          "type": "quantitative",
          "title": "Value ($ Billions)",
          "scale": {"scheme": "blues"}
        },
        "tooltip": [
          {"field": "Full_State", "type": "nominal", "title": "State/Territory"},
          {"field": "economic_value_billions", "type": "quantitative", "title": "Economic Value ($B)"},
          {"field": "volunteers", "type": "quantitative", "title": "Total Volunteers"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"lon": 154, "lat": -33.0, "label": "← NSW: Over $4.3B Value"}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontWeight": "bold",
        "fontStyle": "italic",
        "fontSize": 12,
        "color": "#0f172a"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "label", "type": "nominal"}
      }
    }
  ]
}