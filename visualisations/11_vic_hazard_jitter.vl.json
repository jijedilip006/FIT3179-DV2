{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Jitter plot of Hazard Ratings vs Physical Ratings with Threshold Annotation.",
  "title": {
    "text": "Density of Hazards Across Rugged Terrain",
    "subtitle": [
      "Jittered distribution of danger ratings mapped to physical complexity.",
      "Source: Victorian Beach Facilities & Safety"
    ],
    "anchor": "start", "subtitleFontStyle": "italic", "subtitleColor": "#64748b", "fontSize": 16, "subtitleFontSize": 11, "offset": 15
  },
  "width": 500,
  "height": 300,
  "data": {
    "url": "data/BEACH_FACILITIES_SAFETY.csv"
  },
  "transform": [
    {"calculate": "random()", "as": "jitter"}
  ],
  "layer": [
    {
      "mark": {"type": "circle", "size": 40, "opacity": 0.5},
      "encoding": {
        "x": {
          "field": "PHYSICAL_R",
          "type": "ordinal",
          "title": "Physical Rating (Ruggedness)"
        },
        "y": {
          "field": "HAZARD_RAT",
          "type": "quantitative",
          "title": "Hazard Rating",
          "scale": {"domain": [1, 10]}
        },
        "xOffset": {
          "field": "jitter",
          "type": "quantitative"
        },
        "color": {
          "field": "HAZARD_RAT",
          "type": "quantitative",
          "legend": null,
          "scale": {"scheme": "turbo"}
        },
        "tooltip": [
          {"field": "BEACH", "type": "nominal", "title": "Beach"},
          {"field": "PHYSICAL_R", "type": "ordinal", "title": "Physical Rating"},
          {"field": "HAZARD_RAT", "type": "quantitative", "title": "Hazard Rating"}
        ]
      }
    },
    {
      "mark": {"type": "rule", "color": "#ef4444", "strokeDash": [6, 4], "size": 1.5},
      "encoding": {
        "y": {"datum": 6}
      }
    },
    {
      "mark": {
        "type": "text", 
        "align": "left", 
        "dx": 5, 
        "dy": -10, 
        "color": "#ef4444", 
        "fontWeight": "bold",
        "fontSize": 11
      },
      "encoding": {
        "y": {"datum": 6},
        "x": {"datum": "1"}, 
        "text": {"value": "High Danger Threshold (>6)"}
      }
    }
  ]
}