{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "NSW Coastal Water Quality Observations",
    "subtitle": [
      "Real-time pollution ratings at major beach and inlet locations.",
      "Source: NSW EPA / Beachwatch"
    ],
    "anchor": "start",
    "subtitleFontStyle": "italic",
    "subtitleColor": "#64748b",
    "fontSize": 16,
    "subtitleFontSize": 11,
    "offset": 15
  },
  "width": 500,
  "height": 500,
  "projection": {
    "type": "mercator",
    "center": [148, -33],
    "scale": 2500
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e2e8f0",
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      }
    },
    {
      "data": {
        "url": "../data/data.csv"
      },
      "mark": {
        "type": "circle",
        "stroke": "#334155",
        "strokeWidth": 0.5
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "size": {
          "field": "latest_result_rating",
          "type": "quantitative",
          "title": "Danger Magnitude",
          "scale": {"domain": [1, 4], "range": [300, 40]}
        },
        "color": {
          "field": "latest_result",
          "type": "nominal",
          "title": "Observation Result",
          "scale": {
            "domain": ["Good", "Fair", "Poor", "Bad"],
            "range": ["#10b981", "#facc15", "#f97316", "#ef4444"]
          }
        },
        "opacity": {
          "condition": {"test": "datum.latest_result == 'Good'", "value": 0.2},
          "value": 0.95
        },
        "order": {
          "field": "latest_result_rating",
          "type": "quantitative",
          "sort": "descending"
        },
        "tooltip": [
          {"field": "site_name", "type": "nominal", "title": "Location"},
          {"field": "latest_result", "type": "nominal", "title": "Water Quality"},
          {"field": "latest_result_rating", "type": "quantitative", "title": "Rating"}
        ]
      }
    }
  ]
}