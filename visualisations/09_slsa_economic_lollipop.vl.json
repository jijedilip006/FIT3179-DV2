{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Lollipop chart of SLSA economic value (2024).",
  "title": {
    "text": "Economic Contribution of Volunteer Lifesavers (2024)",
    "subtitle": [
      "Billions of dollars generated by coastal safety networks.",
      "Source: SLSA National Coastal Safety Report"
    ],
    "anchor": "start", "subtitleFontStyle": "italic", "subtitleColor": "#64748b", "fontSize": 16, "subtitleFontSize": 11, "offset": 15
  },
  "width": 400,
  "height": 300,
  "data": {
    "url": "data/slsa_data.csv"
  },
  "transform": [
    {"filter": "datum.year == 2024"}
  ],
  "encoding": {
    "x": {
      "field": "economic_value_billions",
      "type": "quantitative",
      "title": "Value to Community ($ Billions)"
    },
    "y": {
      "field": "state",
      "type": "nominal",
      "sort": {"field": "economic_value_billions", "op": "max", "order": "descending"},
      "axis": {"title": "State", "labelAngle": 0}
    }
  },
  "layer": [
    {
      "mark": {"type": "bar", "size": 3, "color": "#cbd5e1"}
    },
    {
      "mark": {"type": "circle", "size": 250, "color": "#0284c7", "opacity": 1},
      "encoding": {
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "economic_value_billions", "type": "quantitative", "title": "Economic Value ($B)"},
          {"field": "volunteers", "type": "quantitative", "title": "Total Volunteers"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 15,
        "fontSize": 11,
        "fontStyle": "italic",
        "fontWeight": 600,
        "color": "#0f172a"
      },
      "encoding": {
        "x": {"datum": 4.3},
        "y": {"datum": "NSW"},
        "text": {"value": "Over $4.3B generated annually"}
      }
    }
  ]
}